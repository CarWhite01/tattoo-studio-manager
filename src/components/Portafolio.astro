---
// Aquí podrías más adelante traer las imágenes desde una base de datos
---
<section id="portafolio" class="py-24 bg-black px-4">
    <div class="max-w-6xl mx-auto">
        <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="text-xs uppercase tracking-[0.3em] text-red-600 font-semibold block mb-2">Galería</span>
                <h2 class="font-bold text-3xl sm:text-5xl uppercase text-white tracking-tight">Piezas Recientes</h2>
            </div>
            <div class="flex flex-wrap gap-2 text-xs uppercase tracking-wider font-semibold">
                <span class="bg-white text-black px-4 py-2 cursor-pointer">Todos</span>
                <span class="border border-white/10 text-neutral-400 px-4 py-2 hover:border-white/30 cursor-pointer transition-colors">Blackwork</span>
                <span class="border border-white/10 text-neutral-400 px-4 py-2 hover:border-white/30 cursor-pointer transition-colors">Fine Line</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 auto-rows-[300px]">
            <div class="md:col-span-2 md:row-span-2 bg-neutral-900 border border-white/10 relative overflow-hidden group">
                <div class="absolute inset-0 bg-neutral-800 flex items-center justify-center text-neutral-600 font-bold uppercase tracking-widest text-sm">
                    [ Foto Tatuaje Destacado ]
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                <div class="absolute bottom-6 left-6">
                    <span class="text-xs text-red-500 uppercase tracking-widest font-bold">Blackwork</span>
                    <h3 class="text-white font-bold uppercase text-lg mt-1">Manga Completa - Sombras</h3>
                </div>
            </div>

            <div class="md:row-span-2 bg-neutral-900 border border-white/10 relative overflow-hidden group">
                <div class="absolute inset-0 bg-neutral-800 flex items-center justify-center text-neutral-600 font-bold uppercase tracking-widest text-sm">
                    [ Foto Tatuaje Vertical ]
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                <div class="absolute bottom-6 left-6">
                    <span class="text-xs text-red-500 uppercase tracking-widest font-bold">Fine Line</span>
                    <h3 class="text-white font-bold uppercase text-lg mt-1">Geométrico Espalda</h3>
                </div>
            </div>

            <div class="bg-neutral-900 border border-white/10 relative overflow-hidden group">
                <div class="absolute inset-0 bg-neutral-800 flex items-center justify-center text-neutral-600 font-bold uppercase tracking-widest text-sm">
                    [ Foto Miniatura 1 ]
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4">
                    <h3 class="text-white font-bold uppercase text-sm">Lettering Pecho</h3>
                </div>
            </div>

            <div class="bg-neutral-900 border border-white/10 relative overflow-hidden group">
                <div class="absolute inset-0 bg-neutral-800 flex items-center justify-center text-neutral-600 font-bold uppercase tracking-widest text-sm">
                    [ Foto Miniatura 2 ]
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4">
                    <h3 class="text-white font-bold uppercase text-sm">Micro-realismo</h3>
                </div>
            </div>
        </div>
    </div>
</section>