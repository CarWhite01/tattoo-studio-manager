<section class="relative min-h-screen flex items-center justify-center border-b border-white/10">
    <!-- Capa de fondo -->
    <div class="absolute inset-0 bg-neutral-950"></div>
    
    <!-- Contenido -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-20">
        <span class="text-xs uppercase tracking-[0.3em] text-red-600 font-semibold block mb-4">
            Sergio Palma
        </span>
        <h1 class="font-bold text-5xl sm:text-7xl uppercase text-white mb-6 tracking-tight">
            Estudio Privado <br> <span class="text-neutral-500">de Tatuajes</span>
        </h1>
        <p class="text-neutral-400 text-sm sm:text-base max-w-2xl mx-auto mb-10 leading-relaxed">
            Especialistas en Blackwork y Fine Line. Un espacio diseñado para la concentración, privacidad y el arte.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#calendario" class="bg-white text-black font-bold uppercase text-sm px-8 py-4 tracking-wider hover:bg-neutral-200 transition-colors">
                Ver Fechas Libres
            </a>
            <a href="#portafolio" class="border border-white/20 text-white font-bold uppercase text-sm px-8 py-4 tracking-wider hover:bg-white/5 transition-colors">
                Explorar Trabajo
            </a>
        </div>
    </div>
</section>