---
---
<section id="ubicacion" class="py-24 bg-black border-t border-white/10 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
            <span class="text-xs uppercase tracking-[0.3em] text-red-600 font-semibold block mb-2">Ubicación</span>
            <h2 class="font-bold text-3xl sm:text-5xl uppercase text-white mb-6 tracking-tight">El Estudio</h2>
            <p class="text-neutral-400 text-sm sm:text-base leading-relaxed mb-8 max-w-md">
                Nos encontramos en una zona exclusiva de <strong class="text-white">Mixcoac, Benito Juárez, CDMX</strong>. Al ser un estudio privado, la dirección exacta te la mandamos por WhatsApp una vez que confirmes tu cita para mantener la exclusividad y privacidad.
            </p>
            
            <div class="space-y-4 text-sm uppercase tracking-wider font-semibold">
                <div class="flex items-center gap-3 text-neutral-300">
                    <span class="text-red-600 text-lg">📍</span>
                    <span>Mixcoac, Benito Juárez, CDMX</span>
                </div>
                <div class="flex items-center gap-3 text-neutral-300">
                    <span class="text-red-600 text-lg">⏰</span>
                    <span>Lunes a Sábado: 11:00 AM - 8:00 PM</span>
                </div>
            </div>
        </div>

        <div class="bg-neutral-900 border border-white/10 p-2 aspect-video w-full">
            <!-- Mapa de la zona (no la dirección exacta, por privacidad) -->
            <iframe
                title="Mapa de la zona de Mixcoac, CDMX"
                src="https://www.google.com/maps?q=Mixcoac,+Benito+Ju%C3%A1rez,+CDMX&z=15&output=embed"
                class="w-full h-full border-0 grayscale invert-[0.9] contrast-[0.9]"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
            ></iframe>
        </div>
    </div>
</section>